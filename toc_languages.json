{
 "_readme": {
  "这个文件是什么": "ocr2epub 全流水线的语言档案：toc_mark_chapters 扫描各语言 toc_headings 定位目录页并确定语言；renumber_footnotes 按 notes_title 出章末注释块标题；make_epub 按 epub_toc_title/epub_lang/front_title 出阅读器目录页、语言标记与卷首章名。脚本零语言知识，加语言=加数据。语言代码沿流水线用 <输出>.lang sidecar 传递。",
  "怎么新增语言": "照抄一块同语系的已有语言，改 toc_headings 为该国目录页标题词。写原形即可：比较时做 normalize（去空白、去 -_ · • . …、转小写），大小写不敏感，另有 0.85 模糊兜底。块的书写顺序=识别优先级。加完语言建议同时核对 notes_title / epub_toc_title / epub_lang / front_title 四个文案字段。",
  "字段说明（目录识别，toc_mark_chapters 用）": {
   "toc_headings": "目录页标题词列表，命中任一词即定位目录页并锁定该语言",
   "min_len/max_len": "无页码短行按篇名提取的长度窗口（normalize 后计字符）",
   "sentence_punct": "行内含任一即判正文行；西书靠行尾句读+长度窗口，留空",
   "reject_digit_start": "行首数字拒收；西书章号'1. Introduction'必须 false",
   "reason_reject_regex": "目录区逐页判定的拒收正则（zh=作者词/括号）",
   "extract_reject_regex": "标题提取时行命中即跳过（zh=括号）",
   "author_suffix_regex": "标题提取时行尾命中即跳过（zh=行尾 著/译/编）",
   "strip_leading_regex": "提取标题前剥前缀（西书章号）",
   "strip_trailing_roman": "剥行尾罗马页码（'Vorwort VII'→'Vorwort'）",
   "reject_end_punct": "行尾句读判正文行（目录区扩展停止信号）",
   "pagenum_line_breaks": "独立页码行视为目录结束；西书 OCR 常把右栏页码切成独立行，必须 false",
   "skip_roman_line_regex": "整行罗马数字（部号'I.'）/KREU 章号线/阿尔巴尼亚语'Faqe'（页）跳过",
   "colon_split_alias": "'A：B'式条目只登记 B 为别名（中文书防目录全称误配）；西书必须 false",
   "extract_reject_digit_start": "编号开头目录条目拒收为标题（默认 false 不动旧行为）；sq=true——章=KREU 块+大写标题行，编号条目全是章内小节",
   "extra_accept_regex": "行匹配即判目录行（目录区扩展+标题提取两级生效）：行尾页码引用\"… 6.\"、\"⋯24-\"或点线粘连超长行；阿尔巴尼亚语目录页码带句点/短横必配",
   "entry_skip_regex": "标题提取时跳过：条目折行续段的行中页码引用（\" 200. -\"、\"310.—\"），防续段被误提为章标题"
  },
  "字段说明（文案与版式，renumber/make_epub 用）": {
   "label": "语言显示名",
   "notes_title": "章末注释块标题（zh=注释，de=Anmerkungen，en=Notes）",
   "epub_toc_title": "epub 阅读器目录页标题（zh=目录，de=Inhalt，en=Contents）",
   "epub_lang": "dc:language 与 xhtml lang（zh-CN/de/en/fr…）",
   "front_title": "卷首章名（目录之前内容的章节名；空字符串=用书名）",
   "heading_max_len": "章内小节标题判定的短行上限字符数",
   "heading_needs_cjk": "小节标题是否必须含汉字（西书 false）",
   "heading_starts": "行首命中即判标题的前缀列表（zh=§、【）",
   "heading_punct": "行内含任一即非标题的句读集；西书含英文句点、不含逗号（标题可带逗号）",
   "toc_entry_needs_cjk": "make_epub 目录条目/篇名行是否必须含汉字（西书 false）",
   "sent_end": "renumber 断行重排的句尾字符集（西书补英文句点）",
   "reflow_min_len": "renumber 断行重排允许拼接的最小行长度"
  },
  "注意事项": "1) 所有字段可选，缺省回退 zh 块；2) zh 块全部取值与 v0.9 系硬编码逐条等价，已验收中文书行为受保护，不要改 zh；3) 西书语系（拉丁/西里尔/希腊等）共用一套LATIN 模板值，个别文案字段（notes_title/front_title/epub_toc_title）按语言给值，拿不准的暂用英语值，用的人自己改；4) 识别失败时报错列出已搜索标题词，照着加即可。"
 },
